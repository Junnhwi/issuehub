# true면 외부 DB/API 키 없이 "데모 데이터" 레이블이 붙은 예시 데이터로 UI가 작동합니다.
DEMO_MODE=true

# Supabase (Project Settings → API Keys). PUBLISHABLE 키만 공개 가능, SECRET 키는 서버/수집기 전용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub Search REST API 인증 (수집 스크립트 전용, 권한 없는 fine-grained 토큰이면 충분)
GITHUB_TOKEN=

# 한국어 번역·요약 (제목·발췌 번역 + 근거가 충분한 글의 요약)
AI_SUMMARIZATION_ENABLED=false
# 무료(기본): Google AI Studio(https://aistudio.google.com/apikey)에서 발급. 카드 불필요
GEMINI_API_KEY=
# 비우면 gemini-3.5-flash-lite (무료 티어 대상)
GEMINI_MODEL=
# 선택(유료): Anthropic API. Claude Code 구독과 별도 과금. 비우면 claude-opus-5-5
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=
# gemini | anthropic. 비우면 키가 있는 쪽(둘 다 있으면 gemini)
AI_PROVIDER=
# 요청 1회에 묶어 보낼 기사 수 / 요청 간격(ms, 무료 티어 분당 한도 보호, gemini 기본 4500)
AI_BATCH_SIZE=8
AI_REQUEST_INTERVAL_MS=

# 수집기 1회 실행당 소스별 최대 항목 수 / AI 요약 1회 최대 건수
INGEST_BATCH_LIMIT=30
AI_SUMMARY_BATCH_LIMIT=40
# AI 요약 월 최대 시도 건수(비용 상한)
AI_MONTHLY_REQUEST_CAP=3000
