# true면 외부 DB/API 키 없이 "데모 데이터" 레이블이 붙은 예시 데이터로 UI가 작동합니다.
DEMO_MODE=true

# Supabase (Project Settings → API Keys). PUBLISHABLE 키만 공개 가능, SECRET 키는 서버/수집기 전용
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SECRET_KEY=

# GitHub Search REST API 인증 (수집 스크립트 전용, 권한 없는 fine-grained 토큰이면 충분)
GITHUB_TOKEN=

# 선택: Anthropic API 기반 한국어 요약 (Claude Code 구독과 별도 과금)
AI_SUMMARIZATION_ENABLED=false
ANTHROPIC_API_KEY=
# 비워두면 claude-opus-5-5
ANTHROPIC_MODEL=

# 수집기 1회 실행당 소스별 최대 항목 수 / AI 요약 1회 최대 건수
INGEST_BATCH_LIMIT=30
AI_SUMMARY_BATCH_LIMIT=10
# AI 요약 월 최대 시도 건수(비용 상한)
AI_MONTHLY_REQUEST_CAP=1000
